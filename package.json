{
  "name": "hermes-mobile",
  "version": "0.1.1",
  "private": true,
  "description": "Android thin client for Hermes Agent (Capacitor), based on NousResearch/hermes-agent PR #49834.",
  "license": "MIT",
  "workspaces": [
    "apps/desktop",
    "apps/shared",
    "apps/mobile"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "build:mobile": "npm run build --workspace apps/mobile",
    "sync:android": "cd apps/mobile && npx cap sync android",
    "apk:debug": "npm run build:mobile && npm run sync:android && cd apps/mobile/android && ./gradlew assembleDebug",
    "e2e": "npm run build:mobile && node scripts/e2e/run.mjs",
    "e2e:only": "node scripts/e2e/run.mjs"
  },
  "devDependencies": {
    "patch-package": "^8.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@electron/osx-sign": {
      "isbinaryfile": "5.0.7"
    },
    "lodash": "4.18.1",
    "yauzl": "^3.3.1",
    "protobufjs": "^8.7.1",
    "brace-expansion": "5.0.12",
    "mermaid": "11.16.1",
    "dompurify": "3.4.13",
    "ip-address": "10.3.1",
    "nanoid@^3": "3.3.18",
    "nanoid@^6": "6.0.0",
    "js-yaml@^4": "4.3.2",
    "undici@^6": "6.29.0",
    "undici@^7": "7.30.0",
    "postcss": "8.5.23",
    "tar": "7.5.22",
    "source-map-js": "1.2.2",
    "yaml": "2.9.1",
    "vitest": "4.1.11",
    "@vitest/mocker": "4.1.11"
  }
}
