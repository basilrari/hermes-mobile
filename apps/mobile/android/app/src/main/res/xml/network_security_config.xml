<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext (http:// and ws://) is off. The gateway is https:// via tailscale serve. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
